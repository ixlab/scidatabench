  "phase_3": {
    "user_prompt": "Using the downloaded soil physical and chemical properties, construct a plot-level table of the four main environmental axes from the niche-breadth study: soil pH, soil temperature, litter depth, and soil moisture. Average sub-plot measurements to the plot level when necessary, and keep only plots where all four variables are present. Then quantify how correlated these environmental axes are by computing the Spearman rank correlation between every pair of axes (six pairs in total). Report the **mean of the absolute Spearman ρ values** across the six pairs.",
    "expected": 0.4756027330211763,
    "unit": null
  },
  "phase_4": {
    "user_prompt": "Now break the environmental correlation result down by pair, restricting to three of the four environmental axes (soil temperature, litter depth, soil moisture) and excluding soil pH from this part of the analysis. Compute the linear correlation computed on the ranks of the values for each of the three unique pairs among {soilTemp, litterDepth, soilMoisture} and identify the **most negative** pair-wise correlation among these three pairs. Then visualise the resulting 3x3 correlation matrix as a heatmap (annotated with the rho values, diagonal = 1) and save the figure as `neon_env_axis_correlations.png`.",
    "expected": -0.51,
    "unit": null,
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "Among soil temperature, litter depth, and soil moisture, at least one pair shows a strong negative Spearman correlation around -0.5, and at least one other pair is moderately negatively correlated (rho around -0.3). The strongest negative pair is in the -0.5 range (paper reports litterDepth-soilMoisture = -0.51).",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "neon_env_axis_correlations.png",
      "visual_description": "A 3x3 heatmap with rows and columns labelled {Soil Temperature, Litter Depth, Soil Moisture}. Diagonal cells should be 1.0. At least one off-diagonal cell should show a strong negative correlation around -0.5. Cell colour should encode the rho value with a diverging colormap centered at zero.",
