  "phase_3": {
    "user_prompt": "Clean the small mammal data to prepare for home range analysis. Filter for the genus Peromyscus, but remove the monogamous species (californicus, eremicus, and polionotus). Apply an 'ever-adult' criterion based on mass: an individual is classified as adult if it ever met the species-specific mass threshold at any capture event (>=16g for 'small' species maniculatus and leucopus; >=19g for 'large' species keeni, truei, gossypinus, attwateri, boylii). Once classified, include ALL of that individual's captures (regardless of weight or life stage at each individual capture). Remove any obvious outliers (weight > 50g, hindfoot > 28mm, or weight < 10g). Then filter to individuals that were captured at least 5 times across at least 3 unique trap locations. Count the total number of unique individuals that meet these criteria.",
    "expected": 2420,
    "unit": "individuals"
  },
  "phase_4": {
    "user_prompt": "For the qualifying individuals, calculate their 50% smoothed density surface built by summing a kernel placed at each point home range area (in square meters) using their trap coordinates. What is the overall mean home range area across all individuals? Additionally, group the NEON plot vegetation types into three broad categories: 'forest' (deciduous, mixed, evergreen, and woody wetlands), 'grassland' (herbaceous, cultivated crops, pasture hay), and 'shrubland' (shrub/scrub). Create a boxplot comparing the calculated home range areas across these three habitat types, and save it as `homerange_by_habitat.png`.",
    "expected": 1463,
    "unit": "m^2",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "Home range area varies significantly by habitat type. The smallest home ranges are found in structurally complex forested habitats, the largest home ranges are found in less complex grassland habitats, and shrubland habitats fall intermediately between the two.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "homerange_by_habitat.png",
      "visual_description": "A boxplot displaying home range area (y-axis) categorized into three habitat types (x-axis): forest, shrubland, and grassland. The median and interquartile range for 'grassland' should be visibly higher/larger than 'forest', with 'shrubland' positioned intermediately.",
      "paper_figure_reference": "Figure 3"
    }
  }
}
