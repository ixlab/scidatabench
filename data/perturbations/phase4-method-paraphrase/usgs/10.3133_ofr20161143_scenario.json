  "phase_3": {
    "user_prompt": "Merge the water quality sample data with the well depths using the site numbers. For sites with censored arsenic values (e.g., '<0.1'), impute the value as half the detection limit (0.05). Evaluate the samples against regulatory thresholds: count the total number of wells where the arsenic concentration is at or above the EPA Maximum Contaminant Level of 10 µg/L.",
    "expected": 15.0,
    "unit": "wells"
  },
  "phase_4": {
    "user_prompt": "To understand the hydrogeologic controls on these contaminants, compute the rank correlation given by the normalised excess of concordant over discordant pairs between well depth and arsenic concentration. Also, create a scatterplot matrix visualizing the relationships between well depth, arsenic, and radon. Save the visualization as 'contaminant_depth_relations.png'.",
    "expected": 0.42,
    "unit": "Kendall's Tau",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "Both arsenic and radon show a strong positive correlation with well depth, indicating that higher concentrations of these contaminants are typically found in the deeper parts of the aquifer system.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "contaminant_depth_relations.png",
      "visual_description": "A scatterplot matrix or pairplot containing well depth, arsenic, and radon. The plots should demonstrate clear positive trends/correlations between well depth and both arsenic and radon concentrations.",
