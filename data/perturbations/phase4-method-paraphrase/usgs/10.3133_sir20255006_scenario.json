  "phase_3": {
    "user_prompt": "Clean and process the water quality data. Align the measurements so that dissolved oxygen, dissolved iron, and dissolved manganese from the same site on the same day are paired. Handle any left-censored values (e.g., '< 3.2') by converting them to the detection limit value (e.g., 3.2) to allow for non-parametric rank correlation. How many total paired samples (rows containing a valid measurement for both dissolved oxygen and dissolved iron) are there across all 10 wells?",
    "expected": 179,
    "unit": "samples"
  },
  "phase_4": {
    "user_prompt": "Now I want to evaluate the relationship between redox status and trace metal concentrations. Calculate the rank correlation given by the normalised excess of concordant over discordant pairs between dissolved oxygen and dissolved iron across all paired samples from the 10 wells over the study period. What is the rank correlation given by the normalised excess of concordant over discordant pairs correlation coefficient? Additionally, create a scatter plot of Dissolved Iron (y-axis, logarithmic scale if helpful) versus Dissolved Oxygen (x-axis) and save it as `iron_do_scatter.png`.",
    "expected": -0.424,
    "unit": "tau",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "There is a significant negative correlation between dissolved oxygen and dissolved iron in the aquifer. High concentrations of dissolved iron occur almost exclusively when groundwater conditions are anoxic (dissolved oxygen < 0.5 mg/L), indicating reductive dissolution of iron from aquifer sediments under oxygen-depleted conditions.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "iron_do_scatter.png",
      "visual_description": "A scatter plot with Dissolved Oxygen on the x-axis and Dissolved Iron on the y-axis. The data should show an L-shaped or exponential decay pattern, with high iron concentrations clustered at the far left (DO < 1 mg/L) and mostly low or non-detect iron concentrations extending to the right as DO increases up to ~10 mg/L.",
      "paper_figure_reference": "Figure 12 Panel A"
    }
