  "phase_4": {
    "user_prompt": "Let's assess the spatial similarity of the background air pollution and the effect of the lockdown. First, calculate the covariance of the two variables divided by the product of their standard deviations for daily Ozone concentrations between the Ncore and Marion stations over the dataset. Second, create a visualization comparing the average concentrations of PM2.5 during the baseline vs. lockdown periods across the Ncore, Hernando, and Marion sites, with error bars representing standard deviations. Save the plot as `pm25_lockdown_comparison.png`. Finally, summarize whether the lockdown led to significant air quality improvements.",
    "expected": 0.94,
    "unit": "correlation",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The analysis should conclude that the lockdown period did not result in a significant drop in air pollution compared to the 2017-2019 baseline. Concentrations of PM2.5, NO2, and Ozone remained statistically similar to baseline levels, indicating an insignificant impact of the stay-at-home order.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "pm25_lockdown_comparison.png",
      "visual_description": "A grouped bar chart displaying mean PM2.5 concentrations for Ncore, Hernando, and Marion sites. Each site should have two bars side-by-side representing the baseline (2017-2019) and lockdown (2020) periods. Error bars representing standard deviations should be present. The plot should visually confirm minimal differences between the two periods.",
      "paper_figure_reference": "Figure 2 Panel A"
    }
