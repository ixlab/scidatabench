  "phase_3": {
    "user_prompt": "Clean the high-frequency dataset by handling missing values and ensuring the timestamps align. We want to understand the impact of major winter storm events on nutrient pulses before they mix into the tidal estuary. Focus on the Sacramento River at Freeport station. Identify the peak instantaneous nitrate concentration recorded during the major storm event on February 14, 2014.",
    "expected": 1.12,
    "unit": "mg/L"
  },
  "phase_4": {
    "user_prompt": "In tidal environments like Cache Slough, continuous data is necessary to accurately capture constituent transport, which consists of both advective (directional downstream flow) and dispersive (tidally-driven mixing) fluxes. First, compute the total cumulative nitrate flux for the Cache Slough station over the WY 2014-2015 period by continuously multiplying the 15-minute discharge by the simultaneous nitrate concentration. Next, isolate the advective component of this flux (e.g., by using tidally filtered discharge data). What percentage of the total nitrate flux at this station is driven strictly by advection? Additionally, create a time-series line plot comparing the total cumulative nitrate flux and the cumulative advective nitrate flux over this two-year period, saving it as 'cache_slough_nitrate_flux.png'.",
    "expected": 70.0,
    "unit": "%",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "Separating the advective flux from the total flux indicates that the advective flux of nitrate accounts for only about 70 percent of the total nitrate flux at Cache Slough. This highlights that traditional methods using only net flow underestimate total transport by about 30 percent due to the failure to account for substantial dispersive fluxes driven by tidal pumping in the complex wetland environment.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "cache_slough_nitrate_flux.png",
      "visual_description": "A time-series plot spanning from October 2013 to September 2015 showing two monotonically increasing lines. The line representing 'total cumulative nitrate flux' should track substantially higher than the 'cumulative advective nitrate flux' line, with the total flux diverging upward during periods of high flow and ending approximately 30-40% higher than the advective baseline by the end of the time series.",
      "paper_figure_reference": "Figure 13"
    }
  }
