  "phase_3": {
    "user_prompt": "Process the downloaded data to pair stream discharge with wetted width for each site. For each reaeration experiment date, calculate the average wetted width across all measurement stations in the study reach. Then, find the field discharge measurement taken on or closest to that date for the same site. Merge these into a single combined dataset with site, date, average wetted width, and discharge, dropping any paired records that are missing either width or discharge.",
    "expected": 786,
    "unit": "paired measurements"
  },
  "phase_4": {
    "user_prompt": "For each of the 24 stream sites, calculate the at-a-station hydraulic geometry for wetted width by fitting the power-law relationship w = a*Q^b. You can do this by running a linear regression on the log-transformed width and discharge values (log(w) = log(a) + b*log(Q)). Extract the exponent 'b' (the slope) for each site, and then calculate the overall arithmetic mean of 'b' across all 24 sites. Also, create a visualization showing a multi-panel grid of log-log scatter plots of Discharge (Q) vs mean width (w) for all sites, overlaid with their fitted regression lines. Save this plot as `hydraulic_geometry_w_Q.png`.",
    "expected": 0.11,
    "unit": "unitless (exponent)",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The wetted width (w) scales with discharge (Q) according to the power law w = aQ^b. Across the 24 NEON wadeable streams, the exponent b averages 0.11, indicating a relatively weak but positive relationship between discharge and wetted width in these stream channels.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "hydraulic_geometry_w_Q.png",
      "visual_description": "A multi-panel (facetted) scatter plot showing 24 individual subplots (one for each stream site). The x-axis should be log-scaled discharge (Q) and the y-axis should be log-scaled wetted width (w). Each panel should contain points representing paired field measurements and a fitted linear regression line representing the log-log geometric scaling relationship. Most sites should show a positive slope, with varying degrees of scatter.",
      "paper_figure_reference": "Figure 4"
    }
  }
