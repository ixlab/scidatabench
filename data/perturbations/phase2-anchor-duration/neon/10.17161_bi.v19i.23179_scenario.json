  "phase_3": {
    "user_prompt": "Process the downloaded mosquito data by joining the trapping, sorting, and taxonomic identification tables. Keep records for nighttime collections, but also retain events with zero trap hours for later. Filter the dataset to include only trap events where at least 90% of the mosquito subsample was identified to sex, and at least 90% was identified to the species level. Exclude events where trap quality flags (e.g., fan condition, CO2 sublimation, catch cup condition) indicate compromised samples. Finally, calculate the estimated total abundance for each species by dividing the individual count by the proportion of the sample identified. What is the mean estimated abundance per trap event for uncompromised nighttime traps?",
    "expected": 134.8075,
    "unit": "mosquitoes per trap event"
  },
  "phase_4": {
    "user_prompt": "To finalize the dataset, we must infer missing zero counts. First, add zero counts for active traps that caught no female mosquitoes. Second, add zero counts for inactive traps (trap hours = 0) if metadata or remarks indicate weather issues like cold or snow made sampling impractical. Finally, if a species was detected at a site in a given year, add a zero count for that species for any other trap events at that site and year where it was not caught. Calculate the percentage of trap events in the final dataset that are zero-count events. Create a line plot showing the monthly total estimated abundance for the top 3 most common species, and save it as 'mosquito_abundance_timeseries.png'.",
    "expected": 40.0,
    "unit": "%",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "By robustly incorporating zero counts for inactive traps due to cold weather and inferring species-level absences based on site-year presence, approximately 40% of the final dataset consists of zero-count events (roughly 18,000 events). This creates a comprehensive, continuous time series of nighttime female mosquito abundance that accurately reflects phenology and sampling effort.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "mosquito_abundance_timeseries.png",
      "visual_description": "A line plot showing monthly aggregated estimated abundances over the 2014-2022 period for the top three most abundant mosquito species. The plot should display distinct seasonal peaks (phenology) corresponding to summer months and near-zero abundances in winter, reflecting the rigorous inclusion of zero counts.",
      "paper_figure_reference": null
    }
  }
