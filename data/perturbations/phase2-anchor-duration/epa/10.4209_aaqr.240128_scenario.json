  "phase_3": {
    "user_prompt": "Process the data to prepare for the mass closure regression. First, align the daily speciation data with the total PM2.5 mass measurements. Next, calculate the crustal 'Soil' component using the standard elemental oxide equation. Then, calculate non-soil potassium (KNON), and estimate ammonium sulfate and ammonium nitrate proxies from the sulfate and nitrate ions respectively. Filter the dataset to keep only days with complete records for all these components.",
    "expected": {
      "count": 4715,
      "PM25_mean": 7.667276,
      "Soil_mean": 0.33048,
      "KNON_mean": 0.00953,
      "Ammonium_Sulfate_mean": 2.95813,
      "Ammonium_Nitrate_mean": 1.2159
    },
    "unit": null
  },
  "phase_4": {
    "user_prompt": "Run a multiple linear regression (MLR) for the Queens College site using the 'early period' (2002-2006) data to estimate the contribution of Organic Carbon to the total mass. Predict PM2.5 using OC, Ammonium Sulfate, Ammonium Nitrate, and Soil as predictors with fitted coefficients, while treating EC, Na, Cl, and 1.2*KNON as fixed additions (i.e., subtract them from the total mass before regression). Report the fitted coefficient for OC (representing the OM/OC ratio). Finally, repeat this regression for the 2008-2012 and 2014-2018 periods at Queens College, and create a bar chart showing how the OM/OC ratio changes across these three periods. Save the plot as `om_oc_trend_qc.png`.",
    "expected": 0.89,
    "unit": "ratio",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The OM/OC ratio at the urban site (Queens College) indicates a transition from a fresh, anthropogenic emission-dominated regime (ratio ~0.89) to more aged/secondary aerosols over time (ratio increasing to ~1.88 in the later period).",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "om_oc_trend_qc.png",
      "visual_description": "A bar chart or line plot showing three distinct time periods (2002-2006, 2008-2012, 2014-2018) on the x-axis and the OM/OC ratio on the y-axis, demonstrating a clear increasing trend from approximately 0.9 up to nearly 1.9.",
      "paper_figure_reference": "Table 1 (visualized as a trend)"
    }
  }
