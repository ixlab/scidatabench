  "phase_3": {
    "user_prompt": "Process the retrieved data to prepare for regression modeling. First, separate the data into a model development dataset (Water Years 2009-2011, meaning Oct 2008 - Sept 2011) and a verification dataset (Oct 2011 - Apr 2012). Focus on the 'SCanyon' site (Colorado River Above South Canyon Creek, 09085150). Filter its development dataset to keep only records that contain valid, concurrent measurements for salinity, streamflow, and specific conductance. How many valid sampling events remain in this site's development dataset?",
    "expected": 18.0,
    "unit": "samples"
  },
  "phase_4": {
    "user_prompt": "Using the cleaned development dataset (WY 2009-2011) for the SCanyon site, fit an ordinary least squares regression model to estimate the natural log of salinity concentration. Use the natural log of specific conductance as the sole explanatory variable. What is the calculated slope coefficient for the specific conductance term? Also, fit a competing model using the natural log of streamflow instead of specific conductance. Compare the two models. Which explanatory variable provides a better fit (higher Adjusted R-squared, lower standard error) for estimating salinity? Finally, generate a scatter plot comparing the measured salinity concentrations (y-axis) against the estimated salinity concentrations (x-axis) derived from your specific conductance model, and save it as `scanyon_salinity_model_fit.png`.",
    "expected": 1.0133,
    "unit": "coefficient",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The regression model using specific conductance as the explanatory variable performs better than the model using streamflow, demonstrating a higher Adjusted R-squared and a lower standard error.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "scanyon_salinity_model_fit.png",
      "visual_description": "A scatter plot showing measured salinity concentrations on one axis and estimated salinity concentrations (from the specific conductance model) on the other. The points should fall closely along a 1:1 reference line, indicating a strong model fit.",
      "paper_figure_reference": "Figure 2, Panel A"
    }
