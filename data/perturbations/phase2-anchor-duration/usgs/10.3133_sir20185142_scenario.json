  "phase_3": {
    "user_prompt": "Focusing on well 6B (USGS site 395755108211401), I want to quantify the long-term changes in its water level. Extract its daily mean water-level data (depth to water) for the complete water years 2013 through 2016. Calculate the overall decline in the water level (which means an increase in depth to water) from the beginning of this period to the end. Report the approximate total decline in feet.",
    "expected": 11.0,
    "unit": "ft"
  },
  "phase_4": {
    "user_prompt": "Let's investigate the water quality and hydraulic gradients to understand regional flow patterns and potential cross-aquifer mixing. For the Baro well (USGS 400725108250400), retrieve the discrete sample collected in August 2015. What is the dissolved solids concentration (in mg/L) for this sample? Additionally, create a time series plot comparing the daily water levels of well 6A (395755108211400) and well 6B (395755108211401) from 2013 to 2016. Save it as `water_level_trends.png`. Based on the Baro well's chemistry and the behavior of the water levels in 6A and 6B, what can we infer about groundwater mixing and flow dynamics?",
    "expected": 17400.0,
    "unit": "mg/L",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The extreme dissolved solids concentration (17,400 mg/L) at the Baro well indicates mixing of groundwater between the upper and lower aquifers, likely facilitated by nearby faults near the regional discharge area. The water-level time series plot for 6A and 6B should show a gradual decline overall, with a distinct event around April 2015 causing a rapid drop and a temporary reversal of the hydraulic gradient.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "water_level_trends.png",
      "visual_description": "A time series line plot comparing the depth to water (or inferred water-level elevation) for wells 395755108211400 and 395755108211401 from Oct 2012 through Sep 2016. The plot should illustrate a general downward trend in elevation (increase in depth) and highlight a steep, abrupt decline occurring around April 2015 where the lines cross, representing a gradient reversal.",
      "paper_figure_reference": "Figure 8"
    }
  }
