  "phase_3": {
    "user_prompt": "To build the surrogate model for Pier 17, we need to accurately pair the discrete SSC sample measurements with the continuous turbidity data. Process the Pier 17 data by temporally joining each discrete SSC measurement to the nearest 15-minute continuous turbidity (FNU) reading. Ensure the time difference between the sample and the continuous reading is no more than 30 minutes. Drop any records with missing values for either parameter. How many valid paired observations do you have after processing?",
    "expected": 22,
    "unit": "observations"
  },
  "phase_4": {
    "user_prompt": "Using your paired dataset for Pier 17, fit a simple ordinary least squares (OLS) linear regression model to predict Suspended-Sediment Concentration (SSC) using optical turbidity (FNU) as the independent variable. What is the estimated slope coefficient for turbidity? Additionally, create a scatter plot showing the paired data points and the best-fit regression line. Save this visualization as `pier17_ssc_turbidity_rating_curve.png`.",
    "expected": 2.21,
    "unit": "mg/L per FNU",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The surrogate model relates discrete suspended-sediment concentration (SSC) samples to continuous optical turbidity sensor output via linear regression. The plot should display a clear positive linear relationship between Turbidity (FNU) and SSC (mg/L).",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "pier17_ssc_turbidity_rating_curve.png",
      "visual_description": "A scatter plot showing Turbidity (FNU) on the x-axis (range ~10 to 60) and Suspended-sediment concentration (SSC) on the y-axis (range ~10 to 70). The plot must include the discrete data points and an overlaid best-fit positive linear regression line.",
