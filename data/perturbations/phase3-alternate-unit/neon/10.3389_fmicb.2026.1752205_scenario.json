  "phase_3": {
    "user_prompt": "Now, let's process the aquatic cell count data. The NEON dataset provides a raw microbial abundance. Because the samples were preserved in the field, we need to adjust this raw count to account for the dilution. Specifically, the field method indicates that 18 mL of sample water was preserved with 2 mL of 10% formaldehyde. Please calculate the standardized microbial cell density (C) for all records using the equation: C = C_raw * (V_s + V_p) / V_s. After calculating this adjusted cell density, what is the overall average cell density across all sites and times? Report the result in cells per liter (cells L⁻¹).",
    "expected": 1400000000.0,
    "unit": "cells L-1"
  },
  "phase_4": {
    "user_prompt": "Using the matched aquatic dataset, let's examine the environmental drivers. Calculate the Pearson correlation coefficients between the adjusted microbial cell density and three field variables: specific conductance, water temperature, and dissolved oxygen. Also, generate a PCA biplot to visualize the multivariate relationships among these four variables, saving it as `aquatic_microbes_pca.png`. Based on the correlations and the PCA, summarize how specific conductance, water temperature, and dissolved oxygen affect aquatic microbial cell density.",
    "expected": 0.32,
    "unit": "r",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "In aquatic systems, microbial cell density was positively associated with specific conductance and water temperature, but negatively associated with dissolved oxygen.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "aquatic_microbes_pca.png",
      "visual_description": "A PCA biplot showing the relationships among cell density, specific conductance, water temperature, and dissolved oxygen. The plot should illustrate the positive associations of cell density with specific conductance and temperature (vectors pointing in similar directions), and its negative association with dissolved oxygen (vector pointing in the opposite direction).",
      "paper_figure_reference": "Figure 2b"
    }
  }
