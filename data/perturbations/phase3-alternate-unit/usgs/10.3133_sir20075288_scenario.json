  "phase_3": {
    "user_prompt": "Process the discharge data to compute the annual mean streamflow (in cubic meters per second (m³/s)) for each water year at the Colorado River near Cameo station. What was the mean annual streamflow for the driest year in the study period, water year 2002?",
    "expected": 49.5827983826,
    "unit": "m3/s"
  },
  "phase_4": {
    "user_prompt": "Compute the trend in streamflow at the Colorado River near Cameo for water years 1986-2003 using the Seasonal Kendall test with the Sen slope estimator. Use four seasons per water year: Oct-Dec, Jan-Mar, Apr-Jun, and Jul-Sep. For each season-year combination, take the median of the daily mean discharges. Then compute the Sen slope as the median of all pairwise (yj - yi)/(year_j - year_i) slopes formed within the same season, pooled across the four seasons. Also analyze trends in the discrete concentrations of calcium, magnesium, and sulfate to infer the mineralogical drivers of salinity changes. Save a plot of the annual mean streamflow over time with a trendline as `cameo_streamflow_trend.png`.",
    "expected": -24.8,
    "unit": "cfs/year",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The analysis should indicate that processes within source areas bearing calcium, sulfate, and magnesium had the largest effect on the downward trend upstream from Cameo. The steep relative declines in these specific ions implicate reduced dissolution of evaporite minerals, specifically gypsum (calcium sulfate) and dolomite, likely originating from the Mancos Shale and Eagle Valley Evaporite formations.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "cameo_streamflow_trend.png",
      "visual_description": "A line plot or scatter plot showing the annual mean streamflow (in cfs) for water years 1986 through 2003 at the Cameo station (09095500). The y-axis should represent streamflow and the x-axis the water year, with a downward sloping trendline indicating the negative (though potentially not statistically significant) trend of ~ -24.8 cfs/yr.",
      "paper_figure_reference": null
    }
  }
