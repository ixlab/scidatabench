  "phase_3": {
    "user_prompt": "For my chloride mass balance (CMB) calculation, I need the characteristic chloride concentration for each spring. Please process the water quality data to calculate the median dissolved chloride concentration for Carlito Spring (using the USGS site corresponding to that name) during the 2005-2012 period. Exclude any records with missing chloride values. Report the result in micrograms per liter (µg/L).",
    "expected": 1660.0,
    "unit": "ug/L"
  },
  "phase_4": {
    "user_prompt": "I want to estimate the annual groundwater recharge rate for Carlito Spring using the Chloride Mass Balance (CMB) method. The equation is R = P * (Cp / Cs), where P is the average annual precipitation, Cp is the chloride concentration in bulk precipitation, and Cs is the median chloride concentration of the spring water. Based on regional data, assume P = 22.0 inches/year and Cp = 0.30 mg/L. What is the estimated annual recharge rate in inches for Carlito Spring? Additionally, calculate the median Cl:Br mass ratio for all the springs. Based on typical thresholds (e.g., Cl:Br mass ratio > 300 or median Cl > 20 mg/L), briefly discuss which springs show evidence of being impacted by nonmeteoric chloride sources (such as road salt or animal waste) and thus should be excluded from CMB regional recharge averages.",
    "expected": 3.98,
    "unit": "inches",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The analysis should correctly identify Wolf Spring, Cienega Spring (including Upper Cienega), and the unnamed spring near Bills Spring as being impacted by nonmeteoric chloride sources, as they exhibit elevated Cl:Br mass ratios (typically >300) and/or high chloride concentrations compared to the dilute groundwater seen at the other springs.",
      "requires_visual_evaluation": false,
      "expected_visual_filename": null,
      "visual_description": null,
      "paper_figure_reference": null
    }
