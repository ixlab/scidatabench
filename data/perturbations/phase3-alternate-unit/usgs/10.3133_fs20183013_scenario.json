  "phase_3": {
    "user_prompt": "Estuarine specific conductance can spike during dry periods. Focus specifically on the San Mateo Bridge site. Many of these deep-water stations have multiple sensors in the water column; filter the dataset to isolate the upper sensor's specific conductance records. What was the absolute maximum specific conductance recorded by this upper sensor during the two-year study period? Report the result in millisiemens per centimeter (mS/cm).",
    "expected": 51.1,
    "unit": "mS/cm"
  },
  "phase_4": {
    "user_prompt": "Continuous water-quality datasets often have missing periods due to biological fouling or sensor maintenance. To evaluate data completeness, calculate the 'percent valid data' for the upper sensor's water temperature at the San Mateo Bridge site for Water Years 2014-2015. Compute this as the number of valid, non-null 15-minute data points divided by the maximum theoretical number of data points possible in this specific 2-year period (assuming 96 points per day), expressed as a percentage.",
    "expected": 94.0,
    "unit": "%",
