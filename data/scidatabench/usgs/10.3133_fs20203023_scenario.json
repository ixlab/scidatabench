  "phase_3": {
    "user_prompt": "Filter the downloaded data to remove any null or rejected values, retaining only valid observations. To check our processing logic, calculate the data completeness percentage for water temperature at the Alcatraz Island station. The completeness percentage is the number of valid records divided by the theoretical maximum number of 15-minute records for the two water years (using 96 points per day), multiplied by 100. What is this percentage for water temperature at Alcatraz?",
    "expected": 99.0,
    "unit": "percent"
  },
  "phase_4": {
    "user_prompt": "First, expand this completeness calculation to all parameters across all 8 stations (including upper and lower sensors if present). Compute the percentage of valid data points for each sensor. Average these individual percentages to find the overall network-wide data completeness average. Second, create a grouped bar chart visualization comparing the completeness percentages of the three parameters across all sites to see which sensors are most vulnerable. Save this plot as `parameter_completeness_comparison.png`. Finally, state the network average completeness and discuss which parameter exhibits the lowest data recovery and what typical estuarine challenges (e.g., biological fouling) might cause this.",
    "expected": 89.0,
    "unit": "percent",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The overall network data completeness average is approximately 89%. Turbidity consistently has the lowest percentage of valid data across the stations compared to temperature and specific conductance. This lower recovery is largely attributed to biological fouling, which heavily affects optical sensors in estuarine environments.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "parameter_completeness_comparison.png",
      "visual_description": "A bar chart comparing data completeness percentages (Y-axis) for specific conductance, temperature, and turbidity (grouped on the X-axis by site or parameter) across the network. Turbidity should visibly show the lowest completeness values at most sites.",
