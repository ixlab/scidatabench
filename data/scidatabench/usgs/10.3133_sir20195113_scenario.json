  "phase_3": {
    "user_prompt": "With the data downloaded, calculate the daily dissolved zinc load in kilograms per day (kg/d) for each measurement event at the South Fork Coeur d'Alene River above Bunker Creek site (site number 473253116095501). Use the standard conversion equation: Load (kg/d) = Streamflow (cfs) × Concentration (mg/L) × 2.447. Remember to properly convert the USGS zinc concentrations from ug/L to mg/L before applying the formula. Once you have calculated the load for each sampling event at this site, what is the mean dissolved zinc load?",
    "expected": 199.0,
    "unit": "kg/d"
  },
  "phase_4": {
    "user_prompt": "Now we want to determine the zinc loading contributed by groundwater seepage. First, calculate the mean net dissolved zinc load accrual (in kg/d) specifically for the mainstem reach between the site above the seepage area (site 473256116084001) and the site just downstream of the seepage area (site 473253116095501). Calculate the upstream-to-downstream difference for each matched sampling run, then compute the average of those accruals. Second, create a visualization showing the mean dissolved zinc load at each of the four mainstem river sites, ordered from upstream to downstream. Save this plot as `zinc_load_profile.png`. What is the mean net dissolved zinc load accrual for this seepage reach?",
    "expected": 85.0,
    "unit": "kg/d",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The analysis identifies a significant gain in dissolved zinc load (approximately 85 kg/d) between the second and third mainstem sites, indicating substantial metal loading from groundwater seepage in this specific reach. The visualization should show the zinc load remaining low and stable between the first two sites, increasing sharply before the third site, and then continuing to increase slightly or plateau at the fourth site.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "zinc_load_profile.png",
      "visual_description": "A line or scatter plot showing the mean dissolved zinc load (in kg/d) on the y-axis across the four mainstem river sites plotted in upstream-to-downstream spatial order on the x-axis. The plot should display a dramatic jump in load between the second and third sites.",
      "paper_figure_reference": "Figure 3"
    }
  }
