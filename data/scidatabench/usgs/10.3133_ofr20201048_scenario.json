  "phase_3": {
    "user_prompt": "Clean and filter the discrete E. coli data we retrieved. Count the total number of valid E. coli samples retrieved for the Atlanta station over the entire period (October 23, 2000 to May 23, 2019). Then, calculate the percentage of these samples at the Atlanta station that exceeded the EPA Beach Action Value (BAV) of 235 cfu/100 mL.",
    "expected": 30.3,
    "unit": "percent"
  },
  "phase_4": {
    "user_prompt": "Previous studies indicate that turbidity is a strong surrogate for E. coli due to bacteria attaching to suspended sediments. Using the data from the Norcross station during the calibration period (October 4, 2007 to May 23, 2019), align the discrete E. coli samples with the contemporaneous 15-minute turbidity readings. Fit a simple Ordinary Least Squares (OLS) regression model predicting log10(E. coli) using log10(turbidity) as the sole predictor. What is the adjusted R-squared of this baseline model? Finally, create a scatterplot of log10(E. coli) vs log10(turbidity) with the regression line overlaid, and save it as `ecoli_turbidity_norcross.png`.",
    "expected": 0.512,
    "unit": "R-squared",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "There is a strong positive correlation between turbidity and E. coli densities at the Norcross station, indicating that higher suspended sediment concentrations are associated with elevated bacterial levels. This confirms turbidity's utility as a real-time surrogate for predicting recreational water quality.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "ecoli_turbidity_norcross.png",
      "visual_description": "A scatterplot showing log10(turbidity) on the x-axis and log10(E. coli) on the y-axis. The data points should exhibit a clear positive linear trend, with a regression line fitted through the cluster of points showing increasing E. coli with increasing turbidity.",
      "paper_figure_reference": "Figure 6 Panel F"
    }
  }
