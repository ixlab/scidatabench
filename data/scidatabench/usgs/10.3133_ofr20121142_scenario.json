  "phase_3": {
    "user_prompt": "I want to track the water temperature dynamics associated with the blooms. Restrict the analysis to the 11 open-water Upper Klamath Lake sites (MDT-L, MDT-U, EPT-L, SET-L, MDN-L, MDN-U, MRM, RPT, FBS, NBI, WMR); exclude the two Agency Lake sites (AGN, AGS) and the three nearshore sites (SSR, GBE, WDW). Apply the paper's two quality criteria: a site contributes to a given day only if it has at least 19 of 24 hourly readings that day, and a lakewide daily median is computed only on days when at least 9 of the 11 sites contributed. Take the cross-site median across the per-site daily medians. What was the peak (maximum) lakewide daily median water temperature during the 2009 season?",
    "expected": 24.3,
    "unit": "°C"
  },
  "phase_4": {
    "user_prompt": "Using the same 11 UKL open-water sites and the same lakewide daily median methodology from phase 3 (per-site daily median requires >=19 hourly readings; lakewide daily median requires >=9 of 11 sites), calculate the lakewide daily median dissolved oxygen concentration and pH for both the 2009 and 2010 seasons. Create a time series plot of these two parameters to visualize the bloom growth and crash cycles, saving the plot as `ukl_bloom_dynamics.png`. Finally, report the absolute minimum lakewide daily median dissolved oxygen concentration observed during the 2010 season.",
    "expected": 5.0,
    "unit": "mg/L",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "Both 2009 and 2010 exhibited cyanobacteria bloom cycles, characterized by high dissolved oxygen and pH during growth phases, followed by sharp declines (crashes). The first major bloom decline in 2009 (late July) was more severe than the decline in 2010 (late July/early August), reaching lower minimum dissolved oxygen levels and pH compared to the subsequent year.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "ukl_bloom_dynamics.png",
      "visual_description": "A time series plot containing two panels or overlapping lines for dissolved oxygen (mg/L or % saturation) and pH. The x-axis should span May-October for 2009 and 2010. The data should clearly show large dips ('crashes') in both DO and pH in late July 2009, with a less extreme dip occurring slightly later in July/August 2010.",
      "paper_figure_reference": "Figure 2"
    }
  }
}
