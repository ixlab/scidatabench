  "phase_3": {
    "user_prompt": "Process the retrieved discrete sample data. Calculate the overall average of the Uranium-234/Uranium-238 activity ratio across all the collected samples from these sites for the 2018-2019 period.",
    "expected": 2.57,
    "unit": "activity ratio"
  },
  "phase_4": {
    "user_prompt": "A key part of evaluating the previously hypothesized 'fast flow zones' in the aquifer involves checking isotope ratios in the intermediate area between Site 17 and the Badging Facility Well. Isolate the 2019 samples for the 5 wells located in this area: Site 4, USGS 97, USGS 98, USGS 99, and USGS 102. Calculate the mean Uranium-234/Uranium-238 activity ratio for this group of 5 wells. Additionally, create a scatterplot showing the Strontium-87/Strontium-86 ratio on the x-axis and the Uranium-234/Uranium-238 activity ratio on the y-axis for all the 2018-2019 samples you retrieved to visualize the distribution of potential end-members. Save the plot as `isotope_mixing_scatter.png`.",
    "expected": 2.329,
    "unit": "activity ratio",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "The mean U-234/U-238 ratio for the 5 intermediate wells is approximately 2.33, with 4 of the wells having values below 2.35. This refutes the previous hypothesis of a uniform large isotope ratio 'fast flow zone' in this area. The scatterplot should visualize the wide distribution of U and Sr isotopic ratios across the sites, indicating complex mixing from multiple sources (such as rivers and tributary valleys) rather than isolated fast/slow flow paths.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "isotope_mixing_scatter.png",
      "visual_description": "A scatterplot with Sr-87/Sr-86 ratio on the x-axis (ranging roughly from 0.708 to 0.713) and U-234/U-238 activity ratio on the y-axis (ranging roughly from 1.5 to 4.0), showing the widespread distribution of the 28 samples to form a ternary mixing web structure.",
      "paper_figure_reference": "Figure 9"
    }
  }
