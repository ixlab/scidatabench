  "phase_3": {
    "user_prompt": "Using the downloaded water quality data, filter for samples collected during the May 2016 sampling event. What was the highest measured concentration of Clomazone across all monitoring sites during this specific event?",
    "expected": 576.3,
    "unit": "ng/L"
  },
  "phase_4": {
    "user_prompt": "Now let's look at detection frequencies. Calculate the overall detection frequency (as a percentage) for Hexazinone across both the May and October 2016 sampling events combined (i.e., the percentage of all collected samples where Hexazinone was detected at quantifiable levels). Additionally, create a grouped bar chart comparing the detection frequencies of all four pesticides (Hexazinone, Diuron, Azoxystrobin, and Clomazone) grouped by sampling month (May vs. October). Save this plot as `pesticide_detection_frequencies.png`.",
    "expected": 87.5,
    "unit": "%",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "Hexazinone, Diuron, and Azoxystrobin maintained consistently high detection frequencies (>70%) across both the May and October sampling periods. In sharp contrast, Clomazone was highly detected in May (94%) due to seasonal agricultural use but was entirely absent (0% detection) in the October samples.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "pesticide_detection_frequencies.png",
      "visual_description": "A grouped bar chart comparing detection frequencies (0-100%) for Hexazinone, Diuron, Azoxystrobin, and Clomazone. The chart should group the data either by pesticide or by month (May vs. October). It must clearly show Clomazone dropping from >90% in May to 0% in October, while the other three pesticides remain >70% in both months.",
      "paper_figure_reference": "Figures 3 and 5 (combined concept) / Table 5"
    }
  }
}
