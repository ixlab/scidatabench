  "phase_3": {
    "user_prompt": "Process the retrieved discrete water-quality data into an observation matrix. First, resolve any data qualifiers: treat 'M' (presence verified but not quantified) or missing fields as NA; for censored values ('<' or '>'), use the censoring threshold numerical value; and for estimated values ('E'), use the reported numerical value. Aggregate the data so that each row represents a unique sampling event (date/time) and columns are the 27 parameters. After structuring this matrix for the date range October 1, 1990 to September 30, 2016, how many total unique sampling events (rows) are in the dataset?",
    "expected": 596,
    "unit": "observations"
  },
  "phase_4": {
    "user_prompt": "Now construct a discrete Bayesian Network to evaluate parameter predictability. Add a feature for the 'month' of sample collection (1-12). Discretize the 27 continuous water-quality parameters into five equal-frequency intervals (quintiles) and discretize the month into 12 distinct bins. Randomly partition the dataset into an 80% training set and a 20% testing set. Using the training set, fit a Tree Augmented Naive (TAN) Bayesian Network where 'month' is forced to be the target (root) node. Once trained, use the testing set to predict the quintile bin of all 27 parameters given ONLY the 'month' as conditioning evidence. What is the average correct classification rate (accuracy, expressed as a percentage) across all 27 parameters in the testing set?",
    "expected": 40.8,
    "unit": "percent",
