  "phase_3": {
    "user_prompt": "Before running our trend analyses, we need to prepare the data for specific locations. For site 363558110392501 (which corresponds to Shonto PM2), isolate the Total Dissolved Solids (TDS) samples. Ensure the concentration values are numeric, remove any missing (NaN) values, and convert the sample collection dates into fractional years (e.g., July 1, 1990 = 1990.5) to prepare for linear regression modeling. How many valid TDS sample records remain for this site?",
    "expected": 8,
    "unit": "samples"
  },
  "phase_4": {
    "user_prompt": "To determine if there is a long-term increasing trend that might indicate aquifer leakage, perform a simple linear regression. Use the sample date (in fractional years) as the independent variable and the Total Dissolved Solids concentration (mg/L) as the dependent variable for site 363558110392501. What is the R-squared value of this regression? \n\nAdditionally, generate a multi-panel visualization showing the time series and linear trendlines for all three constituents (TDS, Chloride, Sulfate) for both site 363558110392501 and site 354156110413701 (Burro Spring). Save this plot as `black_mesa_wq_trends.png`.",
    "expected": 0.64,
    "unit": "R-squared",
    "checkpoint": {
      "enabled": true,
      "reference_conclusion": "Trend analysis reveals significant increasing trends in dissolved solids, chloride, and sulfate at Shonto PM2 (site 363558110392501), indicating potential induced leakage from an overlying aquifer. In contrast, Burro Spring (site 354156110413701) shows no statistically significant trend for these constituents. The visual plots should clearly depict an upward sloping trendline for Shonto PM2 and a relatively flat trendline for Burro Spring.",
      "requires_visual_evaluation": true,
      "expected_visual_filename": "black_mesa_wq_trends.png",
      "visual_description": "A multi-panel plot comparing two sites (363558110392501 and 354156110413701) across three water quality parameters (TDS, Chloride, Sulfate) with time on the x-axis. Trendlines should be visible, showing a clear upward slope for site 363558110392501 and a mostly flat slope for 354156110413701.",
      "paper_figure_reference": "Figure 12"
    }
  }
